QWidget {
    background-color: #E3F2FD;
    color: #111111;
}

QFrame#Sidebar {
    background-color: #BBDEFB;
    border-right: 1px solid #90CAF9;
}

QLabel#LogoLabel {
    color: #1565C0;
    background: transparent;
    border: none;
}

QLabel#FooterLabel {
    color: #546E7A;
    background: transparent;
    border: none;
}

QWidget#HeaderContainer {
    background: transparent;
    border: none;
}

QPushButton#ToggleButton {
    background: transparent;
    color: #1565C0;
    border: none;
    outline: none;
    padding: 0px;
    text-align: center;
    font-size: 24px;
    min-width: 48px;
    min-height: 48px;
    max-width: 48px;
    max-height: 48px;
}

QPushButton#ToggleButton:hover {
    background-color: #A9D0F5;
    border-radius: 12px;
    border: none;
}

QPushButton#ToggleButton:focus,
QPushButton#ToggleButton:pressed,
QPushButton#ToggleButton:checked {
    border: none;
    outline: none;
}

QPushButton#MenuButton {
    text-align: left;
    padding: 12px;
    border: none;
    border-radius: 8px;
    color: #0D47A1;
    background: transparent;
}

QPushButton#MenuButton:hover {
    background-color: #90CAF9;
}

QListWidget#ConversationList {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#ConversationList::item {
    color: #0D47A1;
    padding: 5px 10px;
    border-radius: 8px;
    margin: 0px 0px;
}

QListWidget#ConversationList::item:hover {
    background-color: #90CAF9;
}

QListWidget#ConversationList::item:selected {
    background-color: #64B5F6;
    color: #0D2E5C;
}

QPushButton#MenuButtonCollapsed {
    text-align: center;
    padding: 0px;
    border: none;
    border-radius: 10px;
    color: #0D47A1;
    background: transparent;
    font-size: 18px;
}

QPushButton#MenuButtonCollapsed:hover {
    background-color: #90CAF9;
}

QLabel#WelcomeLabel {
    color: #37474F;
    background: transparent;
    border: none;
}

QScrollArea#ChatScroll {
    border: none;
    background: transparent;
}

QScrollArea#ChatScroll > QWidget > QWidget {
    background: transparent;
}

QScrollArea#LibraryScroll {
    border: none;
    background: transparent;
}

QScrollArea#LibraryScroll > QWidget > QWidget {
    background: transparent;
}

QToolButton#ScrollArrowButton {
    background: transparent;
    color: #6788AB;
    border: none;
    font-size: 14px;
    font-weight: 900;
    padding: 0px;
}

QToolButton#ScrollArrowButton[edge="true"] {
    color: #2F6FA8;
    font-weight: 900;
}

QToolButton#ScrollArrowButton:hover {
    color: #1F5E97;
}

QFrame#InputContainer {
    background-color: #FFFFFF;
    border: 2px solid #B7D7F2;
    border-radius: 28px;
}

QWidget#InputTopArea,
QWidget#InputFooterArea,
QWidget#RightColumn {
    background: transparent;
    border: none;
}

QWidget#InputFooterArea {
    border-top: none;
}

QTextEdit#InputField {
    border: none;
    outline: none;
    background: transparent;
    color: #1B2B3A;
    padding: 2px 6px 8px 0px;
    selection-background-color: #B7D8F6;
}

QTextEdit#InputField:focus {
    border: none;
    outline: none;
}

QTextEdit#InputField QScrollBar:vertical,
QScrollArea#ChatScroll QScrollBar:vertical {
    width: 0px;
    background: transparent;
}

QScrollBar#OuterInputScrollBar,
QScrollBar#ChatOuterScrollBar {
    background: transparent;
    width: 20px;
    margin: 0px;
    border: none;
}

QScrollBar#OuterInputScrollBar::handle:vertical,
QScrollBar#ChatOuterScrollBar::handle:vertical {
    background: #4B9BDE;
    min-height: 20px;
    border-radius: 2.5px;
    border: none;
    margin-left: 7.5px;
    margin-right: 7.5px;
}

QScrollBar#OuterInputScrollBar::handle:vertical:hover,
QScrollBar#ChatOuterScrollBar::handle:vertical:hover {
    background: #2F8ED9;
}

QScrollBar#OuterInputScrollBar::add-line:vertical,
QScrollBar#OuterInputScrollBar::sub-line:vertical,
QScrollBar#OuterInputScrollBar::add-page:vertical,
QScrollBar#OuterInputScrollBar::sub-page:vertical,
QScrollBar#ChatOuterScrollBar::add-line:vertical,
QScrollBar#ChatOuterScrollBar::sub-line:vertical,
QScrollBar#ChatOuterScrollBar::add-page:vertical,
QScrollBar#ChatOuterScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0px;
}

QPushButton#AttachButton {
    background: transparent;
    color: #4E9AD9;
    border: none;
    font-size: 17px;
    font-weight: 900;
    text-align: center;
    padding: 0px;
    border-radius: 14px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}

QPushButton#AttachButton:hover {
    background: #E3F0FB;
    border: 1px solid #C7DDF2;
}

QPushButton#SendButton {
    background: transparent;
    color: #1565C0;
    font-size: 14px;
    font-weight: 800;
    border: none;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    border-radius: 14px;
    padding: 0px;
    text-align: center;
}

QPushButton#SendButton:hover {
    background: #D7E7F6;
    border: 1px solid #B7D7F2;
}

QPushButton#SendButton:pressed {
    background: #C5DCF1;
    border: 1px solid #A9C8E6;
}

QPushButton#SendButton:disabled {
    color: #90A4AE;
    background: transparent;
    border: none;
}

QLabel#CharCounterLabel {
    background: transparent;
    border: none;
    color: #7B8A97;
    font-size: 11px;
    padding-right: 4px;
}

QLabel#CharCounterLabel[warning="true"] {
    color: #D08A00;
    font-weight: 600;
}

QLabel#CharCounterLabel[exceeded="true"] {
    color: #D84C4C;
    font-weight: 700;
}

QDialog#SettingsDialog {
    background-color: #E3F2FD;
    border: 1px solid #90CAF9;
}

/* Cores em rgba (independentes de tema claro/escuro): dão contraste
   garantido contra qualquer fundo. Opacidade mais alta que a 1ª tentativa —
   8% de opacidade sobre fundo escuro é matematicamente quase igual ao
   fundo (confirmado pixel a pixel), então subimos bem a intensidade pra
   ficar inconfundível como caixa clicável. */
QPushButton#AlternativeButton {
    text-align: left;
    padding: 12px 16px;
    border: 2px solid rgba(21, 101, 192, 0.75);
    border-radius: 10px;
    background-color: rgba(21, 101, 192, 0.22);
}

QPushButton#AlternativeButton:hover:enabled {
    background-color: rgba(21, 101, 192, 0.34);
    border: 2px solid rgba(21, 101, 192, 0.9);
}

QPushButton#AlternativeButton[state="correct"] {
    background-color: rgba(56, 142, 60, 0.35);
    border: 2px solid rgba(56, 142, 60, 0.95);
}

QPushButton#AlternativeButton[state="incorrect"] {
    background-color: rgba(198, 40, 40, 0.32);
    border: 2px solid rgba(198, 40, 40, 0.9);
}

/* Mesma aparência do AlternativeButton de texto, só que pra QToolButton
   (alternativas que são imagem, ex: "qual gráfico representa..." — ícone
   em cima, letra embaixo, centralizado em vez de alinhado à esquerda). */
QToolButton#AlternativeButton {
    text-align: center;
    padding: 10px;
    border: 2px solid rgba(21, 101, 192, 0.75);
    border-radius: 10px;
    background-color: rgba(21, 101, 192, 0.22);
}

QToolButton#AlternativeButton:hover:enabled {
    background-color: rgba(21, 101, 192, 0.34);
    border: 2px solid rgba(21, 101, 192, 0.9);
}

QToolButton#AlternativeButton[state="correct"] {
    background-color: rgba(56, 142, 60, 0.35);
    border: 2px solid rgba(56, 142, 60, 0.95);
}

QToolButton#AlternativeButton[state="incorrect"] {
    background-color: rgba(198, 40, 40, 0.32);
    border: 2px solid rgba(198, 40, 40, 0.9);
}

QLabel#LibraryExplanationLabel {
    background-color: rgba(21, 101, 192, 0.10);
    border: 2px solid rgba(21, 101, 192, 0.4);
    border-radius: 10px;
    padding: 14px 16px;
    font-weight: 500;
}

/* Mesmo padrão do SendButton do chat: invisível em repouso, círculo
   uniforme só aparece no hover. outline: none tira o retângulo de foco que
   o Qt desenha por cima do botão ao clicar — era isso que fazia o círculo
   parecer com "pontos mais fortes" em volta (o foco não acompanha
   perfeitamente o border-radius). */
QPushButton#NextQuestionButton {
    background: transparent;
    color: #1565C0;
    border: 2px solid transparent;
    border-radius: 26px;
    padding: 0px;
    text-align: center;
    outline: none;
}

QPushButton#NextQuestionButton:hover {
    background: rgba(21, 101, 192, 0.28);
    border: 2px solid rgba(21, 101, 192, 0.85);
}

QPushButton#NextQuestionButton:pressed {
    background: rgba(21, 101, 192, 0.4);
}

QPushButton#NextQuestionButton:focus {
    outline: none;
}

QPushButton#PrimaryButton {
    background-color: #1565C0;
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    font-weight: 700;
    outline: none;
}

QPushButton#PrimaryButton:hover {
    background-color: #1B72D1;
}

QPushButton#PrimaryButton:pressed {
    background-color: #0D4E96;
}

/* Botões de diálogo (Login, Configurações) que nunca tiveram estilo próprio
   — sempre usaram a aparência nativa do SO. Com o Fusion, botões sem
   estilo próprio ficam com um visual "cru" (flat, sem realce) — dando esse
   tratamento consistente com o resto do app. */
QPushButton#DialogPrimaryButton {
    background-color: #1565C0;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 700;
    outline: none;
}

QPushButton#DialogPrimaryButton:hover {
    background-color: #1B72D1;
}

QPushButton#DialogPrimaryButton:pressed {
    background-color: #0D4E96;
}

QPushButton#DialogSecondaryButton {
    background-color: rgba(21, 101, 192, 0.10);
    color: #1565C0;
    border: 2px solid rgba(21, 101, 192, 0.55);
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 700;
    outline: none;
}

QPushButton#DialogSecondaryButton:hover {
    background-color: rgba(21, 101, 192, 0.2);
    border: 2px solid rgba(21, 101, 192, 0.75);
}

QPushButton#DialogSecondaryButton:pressed {
    background-color: rgba(21, 101, 192, 0.2);
}

QComboBox {
    border: 2px solid rgba(21, 101, 192, 0.4);
    border-radius: 8px;
    padding: 6px 10px;
    background-color: rgba(21, 101, 192, 0.10);
}

QComboBox:hover {
    border: 2px solid rgba(21, 101, 192, 0.6);
    background-color: rgba(21, 101, 192, 0.16);
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #B7D7F2;
    selection-background-color: #90CAF9;
    outline: none;
    padding: 4px;
}

QCheckBox {
    spacing: 8px;
    background: transparent;
    border: none;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(21, 101, 192, 0.5);
    border-radius: 4px;
    background-color: rgba(21, 101, 192, 0.08);
}

QCheckBox::indicator:hover {
    border: 2px solid rgba(21, 101, 192, 0.85);
}

QCheckBox::indicator:checked {
    background-color: rgba(21, 101, 192, 0.9);
    border: 2px solid rgba(21, 101, 192, 0.9);
}

QLabel#ConteudoGrupoLabel {
    background: transparent;
    border: none;
    color: #546E7A;
    font-weight: 600;
}

QLabel#LibraryTagLabel {
    background: transparent;
    border: none;
    color: #1565C0;
    font-weight: 700;
}

QLineEdit {
    border: 2px solid rgba(21, 101, 192, 0.4);
    border-radius: 8px;
    padding: 6px 12px;
    background-color: rgba(21, 101, 192, 0.06);
}

QLineEdit:focus {
    border: 2px solid rgba(21, 101, 192, 0.7);
    background-color: rgba(21, 101, 192, 0.10);
}

QFrame#ArticleCard {
    background-color: rgba(21, 101, 192, 0.06);
    border: 2px solid rgba(21, 101, 192, 0.25);
    border-radius: 12px;
}

/* Labels dentro do card herdam o fundo opaco padrão do QWidget global —
   sem isso, cada texto vira uma "caixinha" com cor diferente do fundo
   translúcido do card por trás. */
QFrame#ArticleCard QLabel {
    background: transparent;
    border: none;
}

QWidget#ArticleCardButtonRow {
    background: transparent;
    border: none;
}

/* Barra de rolagem da Biblioteca/Laboratório — mesmo visual (cor, formato
   fino arredondado) da barra usada no chat, só que como scrollbar nativa
   do QScrollArea em vez do mecanismo de sincronização externa do chat
   (mais simples de manter pra essas duas telas). */
QScrollArea#LibraryScroll QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
    border: none;
}

QScrollArea#LibraryScroll QScrollBar::handle:vertical {
    background: #4B9BDE;
    min-height: 24px;
    border-radius: 5px;
    border: none;
}

QScrollArea#LibraryScroll QScrollBar::handle:vertical:hover {
    background: #2F8ED9;
}

QScrollArea#LibraryScroll QScrollBar::add-line:vertical,
QScrollArea#LibraryScroll QScrollBar::sub-line:vertical,
QScrollArea#LibraryScroll QScrollBar::add-page:vertical,
QScrollArea#LibraryScroll QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0px;
}

QFrame#ArticleCard:hover {
    border: 2px solid rgba(21, 101, 192, 0.5);
    background-color: rgba(21, 101, 192, 0.12);
}

QLabel#UserBubbleLabel {
    background-color: #ADD4F2;
    color: #111111;
    border-radius: 16px;
    padding: 15px 18px;
    border: 1px solid #7FB6E2;
}

QLabel#BotBubbleLabel {
    background-color: #FFFFFF;
    color: #1A1A1A;
    border-radius: 16px;
    padding: 15px 18px;
    border: 1px solid #C3D4E6;
}

QPushButton#SourcesButton {
    background: transparent;
    color: #1565C0;
    border: 1px solid #1565C0;
    border-radius: 8px;
    padding: 4px 10px;
}
QPushButton#SourcesButton:disabled { color: #888888; border-color: #888888; }
